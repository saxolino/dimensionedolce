---
import BaseLayout from '../layouts/BaseLayout.astro';
import { fetchSanity } from '../lib/sanity';
import { cateringPageQuery } from '../lib/queries';

const preview = Astro.cookies.get('__sanity_preview')?.value === 'true' || Astro.url.searchParams.has('sanity-preview-perspective');
const page = await fetchSanity<any>(cateringPageQuery, preview);
---

<BaseLayout
  title={page?.seoTitle || 'Catering & Eventi | Dimensione Dolce'}
  description={page?.seoDescription || 'Catering dolce per eventi privati e aziendali. Buffet, rinfreschi e allestimenti su misura dalla pasticceria Dimensione Dolce.'}
  preview={preview}
>

<style is:global>
    /* ============================================================
       DIMENSIONE DOLCE — Catering & Eventi
       Page-specific styles only (shared styles in css/shared.css)
       ============================================================ */

    /* Main content offset */
    .main {
      margin-left: 0;
    }

    /* ============================================================
       HERO — Cinematic carousel + centered wordmark (no moon)
       ============================================================ */
    .hero {
      background: var(--nero);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
      padding: 80px 60px;
    }

    /* Carousel slides */
    .hero__carousel {
      position: absolute;
      inset: 0;
      z-index: 0;
    }

    .hero__slide {
      position: absolute;
      inset: 0;
      opacity: 0;
      transition: opacity 1.8s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .hero__slide--active {
      opacity: 1;
    }

    .hero__slide img {
      width: 100%; height: 100%;
      object-fit: cover;
      filter: brightness(0.32) saturate(0.7);
      transform: scale(1.08);
      animation: heroKenBurns 8s ease-out forwards;
    }

    .hero__slide--active img {
      animation: heroKenBurns 8s ease-out forwards;
    }

    @keyframes heroKenBurns {
      from { transform: scale(1.08); }
      to { transform: scale(1); }
    }

    /* Dark overlay gradient */
    .hero__overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to top,
        rgba(30, 25, 24, 0.85) 0%,
        rgba(30, 25, 24, 0.15) 50%,
        rgba(30, 25, 24, 0.35) 100%
      );
      z-index: 1;
    }

    .hero__inner {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      max-width: 1100px;
      width: 100%;
      position: relative;
      z-index: 2;
    }

    .hero__brand {
      display: flex;
      flex-direction: column;
      align-items: center;
      flex-shrink: 0;
      will-change: transform;
    }

    /* Wordmark — clip-path reveal */
    .hero__wordmark {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0;
    }

    /* Lines draw from center outward */
    .hero__line-top,
    .hero__line-bottom {
      height: 1.5px;
      background: rgba(255,255,255,0.6);
      width: 0;
      animation: lineDrawSlow 1.2s cubic-bezier(0.22, 1, 0.36, 1) 0.4s forwards;
    }

    @keyframes lineDrawSlow {
      to { width: 320px; }
    }

    /* "CATERING & EVENTI" — letter-spacing reveal */
    .hero__dimensione {
      font-family: var(--font-ui);
      font-size: 14px;
      font-weight: 600;
      letter-spacing: 1em;
      text-transform: uppercase;
      color: var(--bianco);
      padding: 14px 0;
      opacity: 0;
      animation: dimensioneReveal 1.4s cubic-bezier(0.22, 1, 0.36, 1) 0.6s forwards;
    }

    @keyframes dimensioneReveal {
      to { opacity: 1; letter-spacing: 0.35em; }
    }

    /* "Dolcezza su misura..." — slide up from clip */
    .hero__dolce {
      font-family: var(--font-display);
      font-size: 60px;
      font-weight: 400;
      font-style: italic;
      color: var(--bianco);
      line-height: 1.15;
      margin-top: 12px;
      clip-path: inset(100% 0 0 0);
      animation: dolceClipReveal 1s cubic-bezier(0.22, 1, 0.36, 1) 1s forwards;
    }

    @keyframes dolceClipReveal {
      to { clip-path: inset(0 0 0 0); }
    }

    /* Tagline — fade + subtle slide */
    .hero__tagline {
      max-width: 560px;
      margin-top: 40px;
      opacity: 0;
      transform: translateY(16px);
      animation: taglineIn 1s cubic-bezier(0.22, 1, 0.36, 1) 1.4s forwards;
      text-align: center;
    }

    @keyframes taglineIn {
      to { opacity: 1; transform: translateY(0); }
    }

    .hero__tagline-text {
      font-family: var(--font-ui);
      font-size: 15px;
      font-weight: 400;
      line-height: 1.8;
      color: rgba(255,255,255,0.6);
    }

    /* Scroll indicator */
    .hero__scroll {
      position: absolute;
      bottom: 36px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 3;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      opacity: 0;
      animation: scrollIndicatorIn 0.8s ease 2s forwards;
    }

    .hero__scroll-label {
      font-family: var(--font-ui);
      font-size: 9px;
      font-weight: 500;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.45);
    }

    .hero__scroll-line {
      width: 1px;
      height: 32px;
      background: linear-gradient(to bottom, var(--pistacchio), transparent);
      animation: scrollPulse 2s ease-in-out 3s infinite;
    }

    @keyframes scrollIndicatorIn {
      to { opacity: 1; }
    }

    @keyframes scrollPulse {
      0%, 100% { opacity: 0.4; transform: scaleY(1); }
      50% { opacity: 1; transform: scaleY(1.3); transform-origin: top; }
    }

    @keyframes fadeUp {
      to { opacity: 1; transform: translateY(0); }
    }

    /* ============================================================
       SHOWCASE GALLERY — Asymmetric editorial mosaic
       ============================================================ */
    .showcase {
      background: var(--nero);
      padding: 0;
    }

    .showcase__grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: auto auto;
      gap: 3px;
    }

    .showcase__item {
      overflow: hidden;
      position: relative;
    }

    .showcase__item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .showcase__item:hover img {
      transform: scale(1.05);
    }

    /* First image spans 2 rows (tall) */
    .showcase__item--tall {
      grid-row: span 2;
    }

    .showcase__item--tall img {
      min-height: 100%;
    }

    /* Square items for the remaining 4 */
    .showcase__item--square {
      aspect-ratio: 1 / 1;
    }

    /* ============================================================
       INTRO — Centered intro statement
       ============================================================ */
    .servizio-intro {
      background: var(--bianco);
      padding: 120px 60px;
      text-align: center;
    }

    .servizio-intro__accent {
      width: 40px;
      height: 2px;
      background: var(--pistacchio);
      margin: 0 auto 28px;
    }

    .servizio-intro__title {
      font-family: var(--font-display);
      font-size: clamp(30px, 3vw, 40px);
      font-weight: 400;
      color: var(--testo);
      line-height: 1.2;
      margin-bottom: 24px;
    }

    .servizio-intro__text {
      font-family: var(--font-ui);
      font-size: 15px;
      font-weight: 400;
      line-height: 1.8;
      color: var(--testo-light);
      max-width: 620px;
      margin: 0 auto;
    }

    .servizio-intro__divider {
      width: 60px;
      height: 1px;
      background: var(--beige);
      margin: 48px auto 0;
    }

    /* ============================================================
       I NOSTRI SERVIZI — Alternating image+text blocks (flexbox)
       ============================================================ */
    .process-block {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .process-block__photo {
      aspect-ratio: 1;
      background-size: cover;
      background-position: center;
      position: relative;
      overflow: hidden;
    }

    .process-block__info {
      aspect-ratio: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 56px 52px;
      position: relative;
      overflow: hidden;
    }

    /* Dark cioccolato variant */
    .process-block__info--dark {
      background: var(--cioccolato-deep);
    }

    .process-block__info--dark .process-block__title {
      font-family: var(--font-display);
      font-size: clamp(24px, 2.5vw, 32px);
      font-weight: 400;
      font-style: italic;
      color: var(--bianco);
      line-height: 1.2;
      margin-bottom: 18px;
    }

    .process-block__info--dark .process-block__text {
      font-family: var(--font-ui);
      font-size: 15px;
      font-weight: 400;
      line-height: 1.8;
      color: rgba(255,255,255,0.55);
      max-width: 400px;
    }

    /* White variant */
    .process-block__info--white {
      background: var(--bianco);
    }

    .process-block__info--white .process-block__title {
      font-family: var(--font-display);
      font-size: clamp(24px, 2.5vw, 32px);
      font-weight: 400;
      font-style: italic;
      color: var(--testo);
      line-height: 1.2;
      margin-bottom: 18px;
    }

    .process-block__info--white .process-block__text {
      font-family: var(--font-ui);
      font-size: 15px;
      font-weight: 400;
      line-height: 1.8;
      color: var(--testo-light);
      max-width: 400px;
    }

    /* Pistachio variant */
    .process-block__info--pistacchio {
      background: var(--pistacchio);
    }

    .process-block__info--pistacchio .process-block__title {
      font-family: var(--font-display);
      font-size: clamp(24px, 2.5vw, 32px);
      font-weight: 400;
      font-style: italic;
      color: var(--cioccolato);
      line-height: 1.2;
      margin-bottom: 18px;
    }

    .process-block__info--pistacchio .process-block__text {
      font-family: var(--font-ui);
      font-size: 15px;
      font-weight: 400;
      line-height: 1.8;
      color: var(--cioccolato-deep);
      opacity: 0.75;
      max-width: 400px;
    }

    /* ============================================================
       LE PROPOSTE — Product showcase grid
       ============================================================ */
    .creazioni {
      background: var(--crema-warm);
      padding: 120px 60px;
      text-align: center;
    }

    .creazioni__accent {
      width: 40px;
      height: 2px;
      background: var(--magenta);
      margin: 0 auto 28px;
    }

    .creazioni__title {
      font-family: var(--font-display);
      font-size: clamp(30px, 3vw, 40px);
      font-weight: 400;
      color: var(--testo);
      line-height: 1.2;
      margin-bottom: 16px;
    }

    .creazioni__subtitle {
      font-family: var(--font-ui);
      font-size: 15px;
      font-weight: 400;
      line-height: 1.8;
      color: var(--testo-light);
      max-width: 520px;
      margin: 0 auto 80px;
    }

    .creazioni__grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 40px 32px;
      max-width: 1100px;
      margin: 0 auto;
    }

    /* Product card — same style as menu.html */
    .menu-card {
      text-align: left;
    }

    .menu-card__image {
      aspect-ratio: 1 / 1;
      overflow: hidden;
      background: var(--beige);
      border-radius: 2px;
    }

    .menu-card__image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .menu-card:hover .menu-card__image img {
      transform: scale(1.06);
    }


    .menu-card__body {
      padding: 20px 4px 0;
    }

    .menu-card__name {
      font-family: var(--font-display);
      font-size: 20px;
      font-weight: 400;
      font-style: italic;
      color: var(--testo);
      line-height: 1.3;
      margin-bottom: 8px;
    }

    .menu-card__desc {
      font-family: var(--font-ui);
      font-size: 13px;
      font-weight: 400;
      line-height: 1.7;
      color: var(--testo-light);
      margin-bottom: 12px;
    }

    .menu-card__price {
      font-family: var(--font-ui);
      font-size: 14px;
      font-weight: 600;
      color: var(--pistacchio-scuro);
    }

    /* ============================================================
       CTA — Call to action
       ============================================================ */
    .cta-section {
      background: var(--bianco);
      padding: 150px 60px;
      text-align: center;
    }

    .cta-section__title {
      font-family: var(--font-display);
      font-size: clamp(32px, 4vw, 48px);
      font-weight: 400;
      color: var(--testo);
      line-height: 1.2;
      margin-bottom: 20px;
    }

    .cta-section__text {
      font-family: var(--font-ui);
      font-size: 15px;
      font-weight: 400;
      line-height: 1.8;
      color: var(--testo-light);
      max-width: 480px;
      margin: 0 auto 48px;
    }

    .cta-btn {
      display: inline-block;
      font-family: var(--font-ui);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--magenta);
      border: 1px solid var(--magenta);
      background: transparent;
      padding: 18px 48px;
      cursor: pointer;
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      position: relative;
    }

    .cta-btn:hover {
      background: var(--magenta);
      color: var(--bianco);
      border-color: var(--magenta);
    }

    .cta-section__contacts {
      margin-top: 32px;
      font-family: var(--font-ui);
      font-size: 12px;
      font-weight: 400;
      color: var(--testo-muted);
      line-height: 1.8;
    }

    .cta-section__contacts a {
      color: var(--testo-light);
      transition: color 0.3s;
    }

    .cta-section__contacts a:hover {
      color: var(--pistacchio-scuro);
    }

    /* ---------- GALLERY drag-scroll ---------- */
    .cs-gal { background: var(--bianco); }
    .cs-gal__track { display: flex; gap: 6px; padding: 0 clamp(16px, 4vw, 60px); overflow-x: auto; overflow-y: hidden; scroll-snap-type: x proximity; -webkit-overflow-scrolling: touch; cursor: grab; scrollbar-width: none; height: 620px; }
    .cs-gal__track::-webkit-scrollbar { display: none; }
    .cs-gal__track.is-dragging { cursor: grabbing; scroll-snap-type: none; }
    .cs-gal__item { flex-shrink: 0; width: calc(33.333% - 4px); height: 100%; scroll-snap-align: start; position: relative; overflow: hidden; border-radius: 3px; }
    .cs-gal__item img { width: 100%; height: 100%; object-fit: cover; user-select: none; -webkit-user-drag: none; transition: transform 1.2s cubic-bezier(0.16,1,0.3,1); }
    .cs-gal__item:hover img { transform: scale(1.06); }
    .cs-gal__progress { width: 120px; height: 2px; background: rgba(0,0,0,0.08); margin: 24px auto 0; border-radius: 1px; overflow: hidden; }
    .cs-gal__progress-fill { height: 100%; background: var(--pistacchio); border-radius: 1px; width: 33.3%; transition: transform 0.15s ease-out; }

    @media (max-width: 768px) {
      .cs-gal__track { height: 360px; }
      .cs-gal__item { width: 75%; }
    }

    /* ============================================================
       RESPONSIVE
       ============================================================ */

    /* Tablet */
    @media (max-width: 1024px) {
      .hero { padding: 60px 40px; }
      .hero__dolce { font-size: 48px; }

      .servizio-intro { padding: 100px 40px; }

      .process-block__info { padding: 48px 36px; }

      .creazioni { padding: 100px 40px; }
      .creazioni__grid { gap: 32px 24px; }

      .cta-section { padding: 100px 40px; }

      /* Gallery: 2 columns on tablet */
      .showcase__grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .showcase__item--tall {
        grid-row: span 1;
      }

      .showcase__item--square {
        aspect-ratio: 4 / 3;
      }

      /* Hide 5th gallery image on tablet */
      .showcase__item--hide-tablet {
        display: none;
      }
    }

    /* Mobile */
    @media (max-width: 768px) {
      .main { padding-top: 0; }

      /* Hero mobile */
      .hero {
        min-height: auto;
        padding: 80px 24px 60px;
      }

      .hero__dolce {
        font-size: 40px;
        clip-path: none;
        opacity: 0;
        animation: fadeUp 0.8s ease 0.8s forwards;
      }

      .hero__line-top, .hero__line-bottom { width: 200px; }
      @keyframes lineDrawSlow { to { width: 200px; } }
      .hero__dimensione { font-size: 12px; letter-spacing: 0.3em; }
      .hero__scroll { display: none; }
      .hero__tagline { max-width: 100%; }

      /* Gallery: 1 column on mobile */
      .showcase__grid {
        grid-template-columns: 1fr;
      }

      .showcase__item--tall {
        grid-row: span 1;
      }

      .showcase__item--square {
        aspect-ratio: 16 / 9;
      }

      .showcase__item--hide-mobile {
        display: none;
      }

      /* Servizio intro */
      .servizio-intro { padding: 80px 24px; }

      /* Process blocks stack */
      .process-block {
        grid-template-columns: 1fr;
      }

      /* Always text first, photo second on mobile */
      .process-block__photo { order: 2; aspect-ratio: 4/3; }
      .process-block__info { order: 1; aspect-ratio: 1; padding: 64px 32px; }

      /* Creazioni: 2 columns on mobile */
      .creazioni { padding: 80px 24px; }
      .creazioni__subtitle { margin-bottom: 48px; }
      .creazioni__grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 24px 16px;
      }

      /* CTA */
      .cta-section { padding: 80px 24px; }
    }

    @media (max-width: 480px) {
      .hero__dolce { font-size: 34px; }
      .hero__line-top, .hero__line-bottom { width: 160px; }
      @keyframes lineDrawSlow { to { width: 160px; } }
      .hero__dimensione { font-size: 11px; }

      .creazioni__grid {
        grid-template-columns: 1fr;
        gap: 32px;
        max-width: 360px;
        margin-left: auto;
        margin-right: auto;
      }

      .cta-btn { padding: 16px 36px; font-size: 10px; }
    }

    @media (prefers-reduced-motion: reduce) {
      .hero__wordmark, .hero__tagline, .hero__dolce {
        opacity: 1; transform: none; animation: none; clip-path: none;
      }
      .hero__line-top, .hero__line-bottom { width: 320px; }
      .hero__dimensione { opacity: 1; letter-spacing: 0.35em; animation: none; }
    }
</style>

    <!-- ========== GALLERY — drag-scroll ========== -->
    <section class="cs-gal" style="padding-top:89px;">
      <div class="cs-gal__track" id="galTrack">
        <div class="cs-gal__item"><img src="/assets/img/products/06_Torta_cuore_rossa_glossy.webp" alt="Torta Cuore Rosso" loading="lazy"></div>
        <div class="cs-gal__item"><img src="/assets/img/products/05_Cruffin_ai_frutti_di_bosco.webp" alt="Cruffin" loading="lazy"></div>
        <div class="cs-gal__item"><img src="/assets/img/products/16_Tartina_mango_foglia_doro.webp" alt="Tartina Mango" loading="lazy"></div>
        <div class="cs-gal__item"><img src="/assets/img/products/08_Torta_mousse_bianca_funghetti.webp" alt="Torta Mousse" loading="lazy"></div>
        <div class="cs-gal__item"><img src="/assets/img/products/07_Torta_limone_con_margherite.webp" alt="Torta al Limone" loading="lazy"></div>
        <div class="cs-gal__item"><img src="/assets/img/products/14_Tiramisu_monoporzione.webp" alt="Tiramisu" loading="lazy"></div>
      </div>
      <div class="cs-gal__progress"><div class="cs-gal__progress-fill" id="galFill"></div></div>
    </section>

    <!-- ========== INTRO ========== -->
    <section class="servizio-intro">
      <div class="servizio-intro__accent rv"></div>
      <h2 class="servizio-intro__title rv rv-d1">{page?.introTitle || 'Catering & Eventi'}</h2>
      <p class="servizio-intro__text rv rv-d2">
        {page?.introText || "Portiamo la nostra pasticceria dove vuoi tu. Dalle colazioni aziendali ai ricevimenti nuziali, componiamo buffet dolci su misura con la stessa cura del nostro laboratorio. Ogni dettaglio e' pensato per sorprendere i tuoi ospiti."}
      </p>
      <div class="servizio-intro__divider rv rv-d3"></div>
    </section>

    <!-- ========== I NOSTRI SERVIZI — 4 Blocks ========== -->
    <div id="servizi">

      <!-- Block 1: Info LEFT (dark) — Photo RIGHT -->
      <div class="process-block">
        <div class="process-block__info process-block__info--dark rv">
          <h3 class="process-block__title rv rv-d1">{page?.serviceBlocks?.[0]?.title || 'Colazioni Aziendali'}</h3>
          <p class="process-block__text rv rv-d2">
            {page?.serviceBlocks?.[0]?.text || "Brioche, cornetti, mignon e caffe' di torrefazione per iniziare la giornata con gusto. Servizio completo con allestimento e ritiro."}
          </p>
        </div>
        <div class="process-block__photo" style="background-image: url('/assets/img/products/01_Croissant_crema_e_frutti_rossi.webp');"></div>
      </div>

      <!-- Block 2: Photo LEFT — Info RIGHT (white) -->
      <div class="process-block">
        <div class="process-block__photo" style="background-image: url('/assets/img/products/18_Monoporzione_albicocca.webp');"></div>
        <div class="process-block__info process-block__info--white rv">
          <h3 class="process-block__title rv rv-d1">{page?.serviceBlocks?.[1]?.title || 'Rinfreschi & Aperitivi'}</h3>
          <p class="process-block__text rv rv-d2">
            {page?.serviceBlocks?.[1]?.text || 'Finger food dolci, monoporzioni e composizioni eleganti per cocktail, inaugurazioni e presentazioni.'}
          </p>
        </div>
      </div>

      <!-- Block 3: Info LEFT (pistacchio) — Photo RIGHT -->
      <div class="process-block">
        <div class="process-block__info process-block__info--pistacchio rv">
          <h3 class="process-block__title rv rv-d1">{page?.serviceBlocks?.[2]?.title || 'Buffet Nuziali'}</h3>
          <p class="process-block__text rv rv-d2">
            {page?.serviceBlocks?.[2]?.text || "Il dolce piu' importante del giorno piu' importante. Componiamo angoli dolci completi: torta, confettata, sweet table e bomboniere artigianali."}
          </p>
        </div>
        <div class="process-block__photo" style="background-image: url('/assets/img/patisserie-lievitati.webp');"></div>
      </div>

      <!-- Block 4: Photo LEFT — Info RIGHT (dark) -->
