  <!-- Page-specific: hero carousel + parallax -->
  <script is:inline>
    // Hero carousel
    const slides = document.querySelectorAll('.hero__slide');
    if (slides.length) {
      let currentSlide = 0;
      setInterval(() => {
        slides[currentSlide].classList.remove('hero__slide--active');
        currentSlide = (currentSlide + 1) % slides.length;
        const next = slides[currentSlide];
        next.classList.add('hero__slide--active');
        const img = next.querySelector('img');
        img.style.animation = 'none';
        img.offsetHeight;
        img.style.animation = '';
      }, 6000);
    }

    // Hero parallax on mouse
    const heroEl = document.querySelector('.hero');
    const brandEl = document.querySelector('.hero__brand');
    if (heroEl && window.matchMedia('(min-width: 769px)').matches) {
      heroEl.addEventListener('mousemove', (e) => {
        const rect = heroEl.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;
        if (brandEl) brandEl.style.transform = `translate(${x * -6}px, ${y * -4}px)`;
      });
      heroEl.addEventListener('mouseleave', () => {
        if (brandEl) brandEl.style.transform = '';
      });
    }
  </script>

