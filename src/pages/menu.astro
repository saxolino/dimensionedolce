---
import BaseLayout from '../layouts/BaseLayout.astro';
import { fetchSanity } from '../lib/sanity';
import { menuPageQuery } from '../lib/queries';

const preview = Astro.cookies.get('__sanity_preview')?.value === 'true' || Astro.url.searchParams.has('sanity-preview-perspective');
const page = await fetchSanity<any>(menuPageQuery, preview);
---

<BaseLayout
  title={page?.seoTitle || 'Il Menu | Dimensione Dolce'}
  description={page?.seoDescription || 'Il menu di Dimensione Dolce: gelateria artigianale, pasticceria e colazione. Creazioni preparate ogni giorno con ingredienti freschi e di stagione.'}
  preview={preview}
>

<style is:global>
    /* ============================================================
       DIMENSIONE DOLCE — Menu Page (page-specific styles only)
       Shared styles loaded from css/shared.css
       ============================================================ */

    /* Main content offset */
    .main {
      margin-left: 0;
    }

    /* ============================================================
       HERO — Cinematic carousel (no moon)
       ============================================================ */
    .hero {
      background: var(--nero);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
      padding: 80px 60px;
    }

    /* Carousel slides */
    .hero__carousel {
      position: absolute;
      inset: 0;
      z-index: 0;
    }

    .hero__slide {
      position: absolute;
      inset: 0;
      opacity: 0;
      transition: opacity 1.8s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .hero__slide--active {
      opacity: 1;
    }

    .hero__slide img {
      width: 100%; height: 100%;
      object-fit: cover;
      filter: brightness(0.32) saturate(0.7);
      transform: scale(1.08);
      animation: heroKenBurns 8s ease-out forwards;
    }

    .hero__slide--active img {
      animation: heroKenBurns 8s ease-out forwards;
    }

    @keyframes heroKenBurns {
      from { transform: scale(1.08); }
      to { transform: scale(1); }
    }

    /* Dark overlay gradient */
    .hero__overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to top,
        rgba(30, 25, 24, 0.85) 0%,
        rgba(30, 25, 24, 0.15) 50%,
        rgba(30, 25, 24, 0.35) 100%
      );
      z-index: 1;
    }

    .hero__inner {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      max-width: 1100px;
      width: 100%;
      position: relative;
      z-index: 2;
    }

    .hero__brand {
      display: flex;
      flex-direction: column;
      align-items: center;
      flex-shrink: 0;
      will-change: transform;
    }

    /* Wordmark — clip-path reveal */
    .hero__wordmark {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0;
    }

    /* Lines draw from center outward */
    .hero__line-top,
    .hero__line-bottom {
      height: 1.5px;
      background: rgba(255,255,255,0.6);
      width: 0;
      animation: lineDrawSlow 1.2s cubic-bezier(0.22, 1, 0.36, 1) 0.4s forwards;
    }

    @keyframes lineDrawSlow {
      to { width: 280px; }
    }

    /* IL — letter-spacing reveal */
    .hero__il {
      font-family: var(--font-ui);
      font-size: 16px;
      font-weight: 600;
      letter-spacing: 1em;
      text-transform: uppercase;
      color: var(--bianco);
      padding: 14px 0;
      opacity: 0;
      animation: ilReveal 1.4s cubic-bezier(0.22, 1, 0.36, 1) 0.6s forwards;
    }

    @keyframes ilReveal {
      to { opacity: 1; letter-spacing: 0.45em; }
    }

    /* Menu — slide up from clip */
    .hero__menu-title {
      font-family: var(--font-display);
      font-size: 72px;
      font-weight: 400;
      color: var(--bianco);
      line-height: 1;
      margin-top: 8px;
      clip-path: inset(100% 0 0 0);
      animation: menuClipReveal 1s cubic-bezier(0.22, 1, 0.36, 1) 0.9s forwards;
    }

    @keyframes menuClipReveal {
      to { clip-path: inset(0 0 0 0); }
    }

    /* Tagline — fade + subtle slide */
    .hero__tagline {
      max-width: 480px;
      margin-top: 40px;
      opacity: 0;
      transform: translateY(16px);
      animation: taglineIn 1s cubic-bezier(0.22, 1, 0.36, 1) 1.3s forwards;
      text-align: center;
    }

    @keyframes taglineIn {
      to { opacity: 1; transform: translateY(0); }
    }

    .hero__tagline-text {
      font-family: var(--font-ui);
      font-size: 15px;
      font-weight: 400;
      line-height: 1.8;
      color: rgba(255,255,255,0.6);
    }

    /* Scroll indicator */
    .hero__scroll {
      position: absolute;
      bottom: 36px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 3;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      opacity: 0;
      animation: scrollIndicatorIn 0.8s ease 2s forwards;
    }

    .hero__scroll-label {
      font-family: var(--font-ui);
      font-size: 9px;
      font-weight: 500;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.45);
    }

    .hero__scroll-line {
      width: 1px;
      height: 32px;
      background: linear-gradient(to bottom, var(--pistacchio), transparent);
      animation: scrollPulse 2s ease-in-out 3s infinite;
    }

    @keyframes scrollIndicatorIn {
      to { opacity: 1; }
    }

    @keyframes scrollPulse {
      0%, 100% { opacity: 0.4; transform: scaleY(1); }
      50% { opacity: 1; transform: scaleY(1.3); transform-origin: top; }
    }

    @keyframes fadeUp {
      to { opacity: 1; transform: translateY(0); }
    }

    /* ============================================================
       MENU SECTIONS — Category blocks
       ============================================================ */
    .menu-section {
      padding: 120px 60px;
      text-align: center;
    }

    .menu-section--white {
      background: var(--bianco);
    }

    .menu-section--crema {
      background: var(--crema-warm);
    }

    .menu-section__accent {
      width: 40px;
      height: 2px;
      margin: 0 auto 28px;
    }

    .menu-section__accent--pistacchio {
      background: var(--pistacchio);
    }

    .menu-section__accent--magenta {
      background: var(--magenta);
    }

    .menu-section__title {
      font-family: var(--font-display);
      font-size: clamp(30px, 3vw, 40px);
      font-weight: 400;
      color: var(--testo);
      line-height: 1.2;
      margin-bottom: 20px;
    }

    .menu-section__subtitle {
      font-family: var(--font-ui);
      font-size: 15px;
      font-weight: 400;
      line-height: 1.8;
      color: var(--testo-light);
      max-width: 560px;
      margin: 0 auto 64px;
    }

    /* ============================================================
       PRODUCT GRID
       ============================================================ */
    .menu-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 40px;
      max-width: 1080px;
      margin: 0 auto;
    }

    .menu-grid--2col {
      grid-template-columns: repeat(2, 1fr);
      max-width: 720px;
    }

    .menu-grid + .menu-grid {
      margin-top: 40px;
    }

    /* ============================================================
       PRODUCT CARD — Luxury editorial style
       ============================================================ */
    .menu-card {
      text-align: left;
    }

    .menu-card__image {
      aspect-ratio: 1 / 1;
      overflow: hidden;
      background: var(--crema);
      border-radius: 2px;
    }

    .menu-section--crema .menu-card__image {
      background: var(--beige);
    }

    .menu-card__image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .menu-card:hover .menu-card__image img {
      transform: scale(1.06);
    }

    .menu-card__body {
      padding: 20px 4px 0;
    }

    .menu-card__name {
      font-family: var(--font-display);
      font-size: 20px;
      font-weight: 400;
      font-style: italic;
      color: var(--testo);
      line-height: 1.3;
      margin-bottom: 8px;
    }

    .menu-card__desc {
      font-family: var(--font-ui);
      font-size: 13px;
      font-weight: 400;
      line-height: 1.7;
      color: var(--testo-light);
      margin-bottom: 12px;
    }

    .menu-card__price {
      font-family: var(--font-ui);
      font-size: 14px;
      font-weight: 600;
      color: var(--pistacchio-scuro);
    }

    /* ---------- GALLERY drag-scroll ---------- */
    .cs-gal { background: var(--bianco); }
    .cs-gal__track { display: flex; gap: 6px; padding: 0 clamp(16px, 4vw, 60px); overflow-x: auto; overflow-y: hidden; scroll-snap-type: x proximity; -webkit-overflow-scrolling: touch; cursor: grab; scrollbar-width: none; height: 620px; }
    .cs-gal__track::-webkit-scrollbar { display: none; }
    .cs-gal__track.is-dragging { cursor: grabbing; scroll-snap-type: none; }
    .cs-gal__item { flex-shrink: 0; width: calc(33.333% - 4px); height: 100%; scroll-snap-align: start; position: relative; overflow: hidden; border-radius: 3px; }
    .cs-gal__item img { width: 100%; height: 100%; object-fit: cover; user-select: none; -webkit-user-drag: none; transition: transform 1.2s cubic-bezier(0.16,1,0.3,1); }
    .cs-gal__item:hover img { transform: scale(1.06); }
    .cs-gal__progress { width: 120px; height: 2px; background: rgba(0,0,0,0.08); margin: 24px auto 0; border-radius: 1px; overflow: hidden; }
    .cs-gal__progress-fill { height: 100%; background: var(--pistacchio); border-radius: 1px; width: 33.3%; transition: transform 0.15s ease-out; }

    /* ============================================================
       RESPONSIVE
       ============================================================ */

    /* Tablet */
    @media (max-width: 1024px) {
      .hero { padding: 60px 40px; }
      .hero__menu-title { font-size: 56px; }
      .hero__line-top, .hero__line-bottom { width: 220px; }

      .menu-section { padding: 80px 36px; }
      .menu-grid { gap: 28px; }
    }

    /* Mobile */
    @media (max-width: 768px) {
      .main { padding-top: 0; }
      .cs-gal__track { height: 360px; }
      .cs-gal__item { width: 75%; }

      /* Hero mobile — stacked, centered */
      .hero {
        min-height: auto;
        padding: 60px 24px 48px;
      }

      .hero__menu-title { font-size: 52px; clip-path: none; opacity: 0; animation: fadeUp 0.8s ease 0.8s forwards; }
      .hero__line-top, .hero__line-bottom { width: 200px; }
      .hero__il { font-size: 14px; letter-spacing: 0.35em; }
      .hero__scroll { display: none; }

      .hero__tagline {
        max-width: 100%;
        text-align: center;
      }

      /* Menu sections */
      .menu-section { padding: 64px 24px; }
      .menu-section__subtitle { margin-bottom: 40px; }

      /* Product grid — single column */
      .menu-grid {
        grid-template-columns: 1fr;
        gap: 36px;
        max-width: 400px;
      }

      .menu-grid--2col {
        grid-template-columns: 1fr;
        max-width: 400px;
      }
    }

    @media (max-width: 480px) {
      .hero__menu-title { font-size: 44px; }
      .hero__line-top, .hero__line-bottom { width: 160px; }
      .hero__il { font-size: 12px; }
    }

    @media (prefers-reduced-motion: reduce) {
      .hero__wordmark, .hero__tagline {
        opacity: 1; transform: none; animation: none;
      }
      .hero__il { opacity: 1; letter-spacing: 0.45em; animation: none; }
      .hero__menu-title { opacity: 1; clip-path: none; animation: none; }
      .hero__line-top, .hero__line-bottom { width: 280px; animation: none; }
    }
</style>

    <!-- ========== GALLERY — drag-scroll ========== -->
    <section class="cs-gal" style="padding-top:89px;">
