---
import { fetchSanity } from '../lib/sanity';
import { menuPageQuery } from '../lib/queries';

const preview = Astro.cookies.get('__sanity_preview')?.value === 'true' || Astro.url.searchParams.has('sanity-preview-perspective');
const page = await fetchSanity<any>(menuPageQuery, preview);

type Variant = { name: string; price: number };
type Item = {
  name: string; description: string; badge?: string;
  image: string; variants: Variant[];
  gelatoColor?: string; gelatoKicker?: string;
};
type Section = { title: string; layout: 'products' | 'gelato'; items: Item[] };

const FALLBACK: Section[] = [
  {
    title: 'Colazione', layout: 'products', items: [
      { name: 'Croissant', description: 'Sfoglia dorata, lievitazione di 48 ore, burro francese AOP.',
        image: '/assets/img/products/01_Croissant_crema_e_frutti_rossi.webp', badge: 'Iconico',
        variants: [
          { name: 'Crema e frutti rossi', price: 3.0 },
          { name: 'Pistacchio', price: 3.5 },
          { name: 'Cioccolato', price: 3.2 },
          { name: 'Crema vaniglia', price: 2.8 },
        ]},
      { name: 'Brioche Scanalata', description: 'Impasto soffice al burro, lievitazione naturale, farcitura a scelta.',
        image: '/assets/img/products/02_Brioche_scanalata_con_crema.webp',
        variants: [
          { name: 'Crema Vaniglia', price: 2.8 },
          { name: 'Pistacchio', price: 3.0 },
          { name: 'Cioccolato', price: 2.9 },
        ]},
      { name: 'Pain au Chocolat', description: 'Sfogliatura a spirale, cuore di cioccolato fondente Valrhona.',
        image: '/assets/img/products/04_Pain_au_chocolat_spirale.webp',
        variants: [{ name: 'Classico', price: 3.2 }]},
      { name: 'Bomboloni', description: 'Fritti a mano e zuccherati al momento.',
        image: '/assets/img/products/03_Bomboloni_allo_zucchero.webp',
        variants: [
          { name: 'Naturale', price: 2.5 },
          { name: 'Crema', price: 2.8 },
          { name: 'Nutella', price: 2.8 },
          { name: 'Marmellata', price: 2.8 },
        ]},
      { name: 'Cruffin ai Frutti di Bosco', description: 'Incontro tra croissant e muffin, farcito con composta ai frutti di bosco.',
        image: '/assets/img/products/05_Cruffin_ai_frutti_di_bosco.webp',
        variants: [{ name: 'Classico', price: 3.5 }]},
    ]
  },
  {
    title: 'Monoporzioni', layout: 'products', items: [
      { name: "Limone Trompe-l'oeil", description: 'Mousse al limone e basilico, cuore di gelee agli agrumi, glassa gialla a specchio.',
        image: '/assets/img/products/09_Limone_trompe_loeil.webp', variants: [{ name: 'Monoporzione', price: 7.0 }]},
      { name: 'Pera al Cioccolato', description: 'Mousse al cioccolato fondente, insert di pera Williams, biscotto alle noci.',
        image: '/assets/img/products/10_Pera_al_cioccolato.webp', variants: [{ name: 'Monoporzione', price: 6.5 }]},
      { name: "Pera Trompe-l'oeil", description: 'Mousse alla pera e vaniglia, cuore di caramello al burro salato, glassa realistica.',
        image: '/assets/img/products/11_Pera_trompe_loeil.webp', variants: [{ name: 'Monoporzione', price: 7.0 }]},
      { name: 'Tulipano alla Pesca', description: "Mousse alla pesca e fiori d'arancio, biscotto alla mandorla, petalo dipinto a mano.",
        image: '/assets/img/products/12_Tulipano_pesca.webp', variants: [{ name: 'Monoporzione', price: 7.5 }]},
      { name: 'Cupola Rossa al Cioccolato', description: 'Mousse al cioccolato, glassa rossa lucida a specchio, base brownie fondente.',
        image: '/assets/img/products/13_Cupola_rossa_in_cioccolato.webp', variants: [{ name: 'Monoporzione', price: 7.0 }]},
      { name: 'Tiramisu', description: 'Savoiardi imbevuti nel nostro caffè, crema al mascarpone fresco, cacao Valrhona.',
        image: '/assets/img/products/14_Tiramisu_monoporzione.webp', variants: [{ name: 'Monoporzione', price: 6.0 }]},
      { name: 'Tarte au Citron Meringuée', description: 'Frolla al burro, crema al limone vellutata, meringa italiana fiammeggiata.',
        image: '/assets/img/products/15_Tarte_au_citron_meringuee.webp', variants: [{ name: 'Monoporzione', price: 6.5 }]},
      { name: "Tartina Mango e Foglia d'Oro", description: "Mousse esotica al mango e passion fruit, base croccante, foglia d'oro alimentare.",
        image: '/assets/img/products/16_Tartina_mango_foglia_doro.webp', variants: [{ name: 'Monoporzione', price: 8.0 }]},
      { name: 'Trancio Tre Cioccolati', description: 'Tre strati di mousse fondente, latte e bianco su biscotto croccante al cacao.',
        image: '/assets/img/products/17_Trancio_tre_cioccolati.webp', variants: [{ name: 'Monoporzione', price: 6.0 }]},
      { name: "Monoporzione all'Albicocca", description: "Mousse all'albicocca, insert alla vaniglia Bourbon, glassa arancione brillante.",
        image: '/assets/img/products/18_Monoporzione_albicocca.webp', variants: [{ name: 'Monoporzione', price: 6.5 }]},
      { name: 'Choux alla Crema', description: 'Pasta choux croccante, crema leggera alla vaniglia, finitura al cioccolato.',
        image: '/assets/img/products/20_Choux_alla_crema.webp', variants: [{ name: 'Monoporzione', price: 5.5 }]},
    ]
  },
  {
    title: 'Gelateria', layout: 'gelato', items: [
      { name: 'Pistacchio di Bronte DOP', description: 'Pasta pura di pistacchio siciliano, tostato e macinato a pietra. Intensità verde, note terrose.',
        image: '', variants: [], gelatoColor: '#BBC25C', gelatoKicker: 'Sicilia' },
      { name: 'Amarena e Fior di Latte', description: "Crema al latte fresco con variegatura di amarene sciroppate. Equilibrio dell'acidulo.",
        image: '', variants: [], gelatoColor: '#C06080', gelatoKicker: 'Tradizione' },
      { name: 'Albicocca', description: 'Sorbetto di albicocche del Vesuvio al punto di maturazione. Dolcezza naturale.',
        image: '', variants: [], gelatoColor: '#F4A858', gelatoKicker: 'Stagionale' },
      { name: 'Vaniglia del Madagascar', description: 'Baccelli interi in infusione. La nostra crema classica, densa e profumata.',
        image: '', variants: [], gelatoColor: '#F0E4C8', gelatoKicker: 'Signature' },
      { name: 'Lampone', description: 'Sorbetto ai lamponi freschi, nessun aroma aggiunto. Colore e gusto vividi.',
        image: '', variants: [], gelatoColor: '#D4344B', gelatoKicker: 'Sorbetto' },
      { name: 'Limone di Sorrento', description: 'Sorbetto al limone IGP, scorza e succo. Fresco, pulito, dissetante.',
        image: '', variants: [], gelatoColor: '#F0D84A', gelatoKicker: 'IGP' },
    ]
  }
];

function normalizeItem(it: any): Item {
  const variants: Variant[] = (it.variants && Array.isArray(it.variants) && it.variants.length > 0)
    ? it.variants.map((v: any) => ({ name: v.name || 'Standard', price: Number(v.price) || 0 }))
    : [{ name: 'Standard', price: parseFloat(String(it.price || '0').replace(/[^\d.]/g, '')) || 0 }];
  return {
    name: it.name || '',
    description: it.description || '',
    badge: it.badge || undefined,
    image: it.image?.asset?.url || '',
    variants,
    gelatoColor: it.gelatoColor || undefined,
    gelatoKicker: it.gelatoKicker || undefined,
  };
}

const sections: Section[] = (page?.sections && page.sections.length > 0)
  ? page.sections.map((s: any) => ({
      title: s.title || 'Sezione',
      layout: (s.layout === 'gelato' ? 'gelato' : 'products') as 'gelato' | 'products',
      items: (s.items || []).map(normalizeItem),
    }))
  : FALLBACK;

const lightTextOnGelato = (hex?: string) => {
  if (!hex) return false;
  const h = hex.replace('#','');
  if (h.length < 6) return false;
  const r = parseInt(h.substring(0,2), 16);
  const g = parseInt(h.substring(2,4), 16);
  const b = parseInt(h.substring(4,6), 16);
  const luminance = (0.299*r + 0.587*g + 0.114*b) / 255;
  return luminance < 0.55;
};

const seoTitle = page?.seoTitle || 'Ordina online | Dimensione Dolce';
const seoDescription = page?.seoDescription || 'Componi la tua selezione e ritira in pasticceria. Croissant, monoporzioni, gelato artigianale preparati ogni giorno.';
---
<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{seoTitle}</title>
<meta name="description" content={seoDescription}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style is:global>
  :root {
    --magenta:#E91E8C; --magenta-dark:#C4177A;
    --pistacchio:#BBC25C; --pistacchio-scuro:#A3AA42;
    --cioccolato:#382E2C; --cioccolato-deep:#2C2322;
    --crema:#F2F1F0; --crema-warm:#F7F6F4; --beige:#E8E5E1;
    --bianco:#fff; --testo:#382E2C; --testo-light:#6E6462; --testo-muted:#9A9290;
    --font-display:'Cormorant Garamond',Georgia,serif;
    --font-ui:'Montserrat','Helvetica Neue',sans-serif;
  }
  *,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
  html{scroll-behavior:smooth;-webkit-font-smoothing:antialiased}
  body{font-family:var(--font-ui);font-size:16px;color:var(--testo);background:var(--crema);overflow-x:hidden}
  a{color:inherit;text-decoration:none}
  img{display:block;max-width:100%}
  button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit}

  .hdr{position:sticky;top:0;z-index:50;background:rgba(242,241,240,0.88);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border-bottom:1px solid rgba(56,46,44,0.08)}
  .hdr__inner{max-width:1400px;margin:0 auto;padding:18px 40px;display:flex;align-items:center;gap:32px}
  .hdr__brand{display:flex;align-items:center}
  .hdr__brand img{height:38px;width:auto;display:block}
  .hdr__tabs{display:flex;gap:4px;margin-left:auto;overflow-x:auto;scrollbar-width:none}
  .hdr__tabs::-webkit-scrollbar{display:none}
  .hdr__tab{font-family:var(--font-ui);font-size:11px;font-weight:500;letter-spacing:.18em;text-transform:uppercase;color:var(--testo-muted);padding:10px 18px;border-radius:999px;white-space:nowrap;transition:all .3s}
  .hdr__tab:hover{color:var(--testo)}
  .hdr__tab.is-active{background:var(--cioccolato);color:var(--bianco)}
  .hdr__cart{display:flex;align-items:center;gap:8px;padding:8px 16px;border:1px solid var(--cioccolato);border-radius:999px;font-size:11px;letter-spacing:.15em;text-transform:uppercase;font-weight:600;transition:all .3s}
  .hdr__cart:hover{background:var(--cioccolato);color:var(--bianco)}
  .hdr__cart-count{background:var(--pistacchio);color:var(--cioccolato);border-radius:999px;min-width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;padding:0 6px}

  .hero{padding:120px 40px 80px;text-align:center;background:linear-gradient(180deg,var(--crema-warm) 0%,var(--crema) 100%)}
  .hero__kicker{font-family:var(--font-ui);font-size:11px;font-weight:600;letter-spacing:.3em;text-transform:uppercase;color:var(--pistacchio-scuro);margin-bottom:24px}
  .hero__title{font-family:var(--font-display);font-size:clamp(48px,8vw,104px);font-weight:400;line-height:.95;color:var(--testo);font-style:italic}
  .hero__title em{color:var(--pistacchio-scuro);font-style:italic;font-weight:500}
  .hero__lede{max-width:520px;margin:32px auto 0;font-size:15px;line-height:1.8;color:var(--testo-light)}

  .sec{padding:80px 0;position:relative}
  .sec--white{background:var(--bianco)}
  .sec__head{max-width:1200px;margin:0 auto 56px;padding:0 40px 24px;display:flex;align-items:baseline;gap:24px;border-bottom:1px solid rgba(56,46,44,0.08)}
  .sec__num{font-family:var(--font-display);font-style:italic;font-size:28px;color:var(--pistacchio-scuro);font-weight:500;min-width:40px}
  .sec__title{font-family:var(--font-display);font-size:clamp(32px,4vw,48px);font-weight:400;color:var(--testo);line-height:1}
  .sec__count{margin-left:auto;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--testo-muted);font-weight:500}

  .carousel{position:relative;overflow:hidden;padding:20px 0;-webkit-mask-image:linear-gradient(90deg,transparent 0%,black 4%,black 96%,transparent 100%);mask-image:linear-gradient(90deg,transparent 0%,black 4%,black 96%,transparent 100%)}
  .carousel__track{display:flex;gap:32px;width:max-content;animation:marquee 80s linear infinite;will-change:transform;padding:0 16px}
  .carousel:hover .carousel__track,.carousel:focus-within .carousel__track{animation-play-state:paused}
  @keyframes marquee{from{transform:translateX(0)}to{transform:translateX(calc(-50% - 16px))}}

  .prod{flex:0 0 auto;width:320px;position:relative;transition:transform .6s cubic-bezier(.16,1,.3,1)}
  .prod:hover{transform:translateY(-6px)}
  .prod__img{position:relative;aspect-ratio:4/5;overflow:hidden;background:var(--beige);border-radius:4px}
  .prod__img img{width:100%;height:100%;object-fit:cover;transition:transform 1.4s cubic-bezier(.16,1,.3,1)}
  .prod:hover .prod__img img{transform:scale(1.06)}
  .prod__badge{position:absolute;top:16px;left:16px;background:var(--bianco);color:var(--cioccolato);font-size:10px;font-weight:600;letter-spacing:.15em;text-transform:uppercase;padding:6px 12px;border-radius:999px;z-index:2}
  .prod__add{position:absolute;bottom:16px;right:16px;width:44px;height:44px;border-radius:999px;background:var(--cioccolato);color:var(--bianco);font-size:20px;font-weight:300;display:flex;align-items:center;justify-content:center;opacity:0;transform:translateY(8px);transition:all .4s cubic-bezier(.16,1,.3,1);z-index:2}
  .prod:hover .prod__add,.prod:focus-within .prod__add{opacity:1;transform:translateY(0)}
  .prod__add:hover{background:var(--pistacchio);color:var(--cioccolato);transform:scale(1.08)!important}
  .prod__body{padding:20px 2px 0}
  .prod__name{font-family:var(--font-display);font-style:italic;font-size:22px;font-weight:400;color:var(--testo);line-height:1.2;margin-bottom:8px}
  .prod__desc{font-size:13px;line-height:1.6;color:var(--testo-light);margin-bottom:16px;min-height:42px}
  .prod__variants{display:flex;gap:6px;margin-bottom:14px;flex-wrap:wrap}
  .prod__variant{font-family:var(--font-ui);font-size:11px;font-weight:500;letter-spacing:.06em;padding:7px 14px;border:1px solid rgba(56,46,44,0.18);border-radius:999px;color:var(--testo-light);transition:all .3s;line-height:1}
  .prod__variant:hover{border-color:var(--testo);color:var(--testo)}
  .prod__variant.is-active{background:var(--cioccolato);border-color:var(--cioccolato);color:var(--bianco)}
  .prod__footer{display:flex;align-items:baseline;justify-content:space-between}
  .prod__price{font-family:var(--font-display);font-style:italic;font-size:22px;font-weight:500;color:var(--pistacchio-scuro);transition:opacity .3s}
  .prod__price-from{font-size:10px;letter-spacing:.15em;text-transform:uppercase;color:var(--testo-muted);font-family:var(--font-ui);font-weight:500;font-style:normal;margin-right:4px}

  .gelato{flex:0 0 auto;width:280px;aspect-ratio:3/4;border-radius:4px;overflow:hidden;position:relative;display:flex;flex-direction:column;justify-content:flex-end;padding:28px;transition:transform .6s cubic-bezier(.16,1,.3,1);cursor:default}
  .gelato:hover{transform:translateY(-6px)}
  .gelato::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 30% 30%,rgba(255,255,255,0.4),transparent 60%);opacity:.6}
  .gelato > *{position:relative;z-index:1}
  .gelato__kicker{font-size:10px;letter-spacing:.25em;text-transform:uppercase;font-weight:600;margin-bottom:12px;opacity:.7}
  .gelato__name{font-family:var(--font-display);font-style:italic;font-size:32px;font-weight:500;line-height:1.05;margin-bottom:14px}
  .gelato__desc{font-size:13px;line-height:1.6;opacity:.75}

  .toast{position:fixed;bottom:-100px;left:50%;transform:translateX(-50%);background:var(--cioccolato);color:var(--bianco);padding:14px 24px;border-radius:999px;font-size:13px;font-weight:500;letter-spacing:.05em;display:flex;align-items:center;gap:12px;box-shadow:0 12px 40px rgba(0,0,0,.2);transition:bottom .5s cubic-bezier(.16,1,.3,1);z-index:100}
  .toast.is-visible{bottom:24px}
  .toast__dot{width:6px;height:6px;border-radius:999px;background:var(--pistacchio)}

  @media(max-width:768px){
    .hdr__inner{padding:14px 20px;gap:16px}
    .hdr__brand img{height:30px}
    .hdr__tab{font-size:10px;padding:8px 14px}
    .hdr__cart{padding:8px 12px;font-size:10px}
    .hero{padding:72px 24px 56px}
    .sec{padding:56px 0}
    .sec__head{margin-bottom:36px;padding:0 20px 20px;flex-wrap:wrap;gap:12px}
    .sec__count{width:100%;margin-left:0;order:3}
    .carousel__track{gap:20px;padding:0 12px;animation-duration:60s}
    .prod{width:260px}
    .prod__img{aspect-ratio:1/1}
    .prod__add{opacity:1;transform:none;width:44px;height:44px}
    .gelato{width:230px;padding:22px}
    .gelato__name{font-size:26px}
  }
  @media(prefers-reduced-motion:reduce){.carousel__track{animation:none}}

  /* ORDER PANEL */
  .order-backdrop{position:fixed;inset:0;background:rgba(30,25,24,0.55);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);opacity:0;visibility:hidden;transition:opacity .4s,visibility .4s;z-index:90}
  .order-backdrop.is-open{opacity:1;visibility:visible}
  .order{position:fixed;top:0;right:0;bottom:0;width:460px;max-width:100vw;background:var(--crema);transform:translateX(100%);transition:transform .55s cubic-bezier(.22,1,.36,1);z-index:91;display:flex;flex-direction:column;box-shadow:-30px 0 80px rgba(0,0,0,.18)}
  .order.is-open{transform:translateX(0)}
  .order__head{padding:32px 36px 20px;border-bottom:1px solid rgba(56,46,44,.08);position:relative;flex-shrink:0;background:var(--crema)}
  .order__kicker{font-size:10px;letter-spacing:.3em;text-transform:uppercase;color:var(--pistacchio-scuro);font-weight:700;margin-bottom:10px}
  .order__title{font-family:var(--font-display);font-style:italic;font-size:38px;font-weight:500;line-height:1;color:var(--testo)}
  .order__close{position:absolute;top:28px;right:28px;width:38px;height:38px;border-radius:999px;font-size:18px;color:var(--testo-light);transition:all .3s;display:flex;align-items:center;justify-content:center;line-height:1}
  .order__close:hover{background:var(--cioccolato);color:var(--bianco)}
  .order__scroll{flex:1;overflow-y:auto;overflow-x:hidden}
  .order__empty{padding:80px 36px 60px;text-align:center}
  .order__empty-mark{font-family:var(--font-display);font-style:italic;font-size:72px;color:var(--pistacchio);line-height:1;margin-bottom:24px;letter-spacing:-0.02em}
  .order__empty-title{font-family:var(--font-display);font-style:italic;font-size:24px;font-weight:500;color:var(--testo);margin-bottom:8px}
  .order__empty-text{font-size:13px;color:var(--testo-light);line-height:1.7;max-width:280px;margin:0 auto}
  .order__list{padding:16px 36px 8px}
  .order__list-label{font-size:10px;letter-spacing:.28em;text-transform:uppercase;color:var(--testo-muted);font-weight:600;padding:12px 0 8px;border-bottom:1px solid rgba(56,46,44,.06);margin-bottom:4px;display:flex;justify-content:space-between}
  .order__item{display:grid;grid-template-columns:1fr auto;gap:6px 16px;padding:18px 0;border-bottom:1px solid rgba(56,46,44,.06);animation:itemIn .45s cubic-bezier(.22,1,.36,1)}
  @keyframes itemIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
  .order__item-name{font-family:var(--font-display);font-style:italic;font-size:20px;font-weight:500;line-height:1.15;color:var(--testo);padding-right:8px}
  .order__item-price{font-family:var(--font-display);font-style:italic;font-size:20px;font-weight:500;color:var(--testo);text-align:right;white-space:nowrap}
  .order__item-variant{grid-column:1/-1;font-size:10px;letter-spacing:.22em;text-transform:uppercase;color:var(--testo-muted);font-weight:600;margin-top:-2px}
  .order__item-controls{grid-column:1/-1;display:flex;align-items:center;gap:12px;margin-top:6px}
  .order__qty{display:inline-flex;align-items:center;border:1px solid rgba(56,46,44,.18);border-radius:2px}
  .order__qty button{width:28px;height:28px;font-size:14px;color:var(--testo-light);transition:color .2s;line-height:1}
  .order__qty button:hover{color:var(--testo)}
  .order__qty-val{min-width:24px;text-align:center;font-weight:600;font-size:12px}
  .order__item-remove{margin-left:auto;font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:var(--testo-muted);font-weight:600;padding:4px 8px;transition:color .2s}
  .order__item-remove:hover{color:var(--magenta-dark)}
  .order__totals{padding:20px 36px;background:var(--crema-warm);border-top:1px solid rgba(56,46,44,.06);border-bottom:1px solid rgba(56,46,44,.06)}
  .order__total-row{display:flex;justify-content:space-between;align-items:baseline;padding:4px 0;font-size:13px;color:var(--testo-light)}
  .order__total-row.is-total{padding:10px 0 0;margin-top:8px;border-top:1px dashed rgba(56,46,44,.18)}
  .order__total-row.is-total .order__total-label{font-size:11px;letter-spacing:.24em;text-transform:uppercase;font-weight:700;color:var(--testo)}
  .order__total-value{font-family:var(--font-display);font-style:italic;font-weight:500;color:var(--testo)}
  .order__total-row.is-total .order__total-value{font-size:30px;letter-spacing:-.01em}
  .order__form{padding:28px 36px 8px}
  .order__form-head{display:flex;align-items:baseline;gap:12px;margin-bottom:6px}
  .order__form-num{font-family:var(--font-display);font-style:italic;font-size:14px;color:var(--pistacchio-scuro);font-weight:500}
  .order__form-title{font-family:var(--font-display);font-style:italic;font-size:22px;font-weight:500;color:var(--testo)}
  .order__form-sub{font-size:12px;color:var(--testo-muted);margin-bottom:24px;line-height:1.6}
  .order__field{margin-bottom:20px;position:relative}
  .order__row{display:grid;grid-template-columns:1fr 1fr;gap:20px}
  .order__label{display:block;font-size:10px;letter-spacing:.22em;text-transform:uppercase;color:var(--testo-muted);font-weight:600;margin-bottom:6px}
  .order__label .req{color:var(--pistacchio-scuro);margin-left:3px}
  .order__input{width:100%;border:none;border-bottom:1px solid rgba(56,46,44,.22);background:transparent;padding:8px 0 10px;font-family:var(--font-ui);font-size:14px;color:var(--testo);transition:border-color .3s;outline:none}
  .order__input:focus{border-bottom-color:var(--pistacchio-scuro)}
  .order__input::placeholder{color:var(--testo-muted);font-style:italic;font-weight:400}
  .order__consents{padding:12px 36px 20px}
  .order__consent{display:flex;align-items:flex-start;gap:12px;padding:10px 0;cursor:pointer;position:relative}
  .order__consent input{position:absolute;opacity:0;pointer-events:none}
  .order__consent-box{width:18px;height:18px;border:1.5px solid rgba(56,46,44,.3);border-radius:2px;flex-shrink:0;display:flex;align-items:center;justify-content:center;transition:all .2s;margin-top:2px;background:var(--bianco)}
  .order__consent input:checked + .order__consent-box{background:var(--cioccolato);border-color:var(--cioccolato)}
  .order__consent-box::after{content:'';width:9px;height:5px;border-left:1.5px solid var(--pistacchio);border-bottom:1.5px solid var(--pistacchio);transform:rotate(-45deg) scale(0);transition:transform .2s;margin-top:-2px}
  .order__consent input:checked + .order__consent-box::after{transform:rotate(-45deg) scale(1)}
  .order__consent-text{font-size:12px;line-height:1.65;color:var(--testo-light)}
  .order__consent-text a{color:var(--testo);border-bottom:1px solid rgba(56,46,44,.25);transition:border-color .3s}
  .order__consent-text a:hover{border-bottom-color:var(--testo)}
  .order__footer{padding:20px 36px 28px;border-top:1px solid rgba(56,46,44,.08);background:var(--bianco)}
  .order__submit{width:100%;padding:18px;background:var(--cioccolato);color:var(--bianco);border-radius:2px;font-size:11px;letter-spacing:.24em;text-transform:uppercase;font-weight:700;transition:all .35s cubic-bezier(.16,1,.3,1);position:relative;overflow:hidden}
  .order__submit:hover:not(:disabled){background:var(--pistacchio-scuro)}
  .order__submit:disabled{opacity:.45;cursor:not-allowed}
  .order__submit-note{margin-top:12px;text-align:center;font-size:10px;letter-spacing:.22em;text-transform:uppercase;color:var(--testo-muted);font-weight:500}
  .order__success{padding:80px 36px;text-align:center;animation:fadeIn .6s cubic-bezier(.22,1,.36,1)}
  @keyframes fadeIn{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
  .order__success-seal{width:92px;height:92px;border-radius:999px;border:1px solid var(--pistacchio);margin:0 auto 32px;display:flex;align-items:center;justify-content:center;font-family:var(--font-display);font-style:italic;font-size:36px;color:var(--pistacchio-scuro);font-weight:500;position:relative}
  .order__success-seal::before,.order__success-seal::after{content:'';position:absolute;width:4px;height:4px;border-radius:999px;background:var(--pistacchio)}
  .order__success-seal::before{top:-6px;left:50%;transform:translateX(-50%)}
  .order__success-seal::after{bottom:-6px;left:50%;transform:translateX(-50%)}
  .order__success-title{font-family:var(--font-display);font-style:italic;font-size:32px;font-weight:500;color:var(--testo);margin-bottom:14px;line-height:1.1}
  .order__success-text{font-size:13.5px;line-height:1.8;color:var(--testo-light);margin:0 auto 32px;max-width:300px}
  .order__success-ref{padding:14px 24px;background:var(--bianco);border-radius:2px;display:inline-block;font-size:10px;letter-spacing:.22em;text-transform:uppercase;color:var(--testo-muted);font-weight:600}
  .order__success-ref strong{font-family:var(--font-ui);color:var(--testo);font-weight:700;font-size:13px;letter-spacing:.18em;margin-left:8px}
  .order__success-action{margin-top:40px}
  .order__success-action button{font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--testo);font-weight:600;border-bottom:1px solid var(--pistacchio);padding:4px 0;transition:color .2s}
  .order__success-action button:hover{color:var(--pistacchio-scuro)}
  @media(max-width:768px){
    .order{width:100%;top:auto;bottom:0;height:88vh;border-radius:22px 22px 0 0;transform:translateY(100%);box-shadow:0 -20px 60px rgba(0,0,0,.18)}
    .order.is-open{transform:translateY(0)}
    .order::before{content:'';position:absolute;top:10px;left:50%;transform:translateX(-50%);width:40px;height:4px;background:rgba(56,46,44,.18);border-radius:999px}
    .order__head{padding:28px 24px 16px}
    .order__title{font-size:30px}
    .order__close{top:18px;right:18px}
    .order__list{padding:12px 24px 4px}
    .order__totals{padding:18px 24px}
    .order__form{padding:24px 24px 4px}
    .order__consents{padding:10px 24px 16px}
    .order__footer{padding:16px 24px 24px}
    .order__success{padding:60px 24px}
  }
</style>
</head>
<body>
<header class="hdr">
  <div class="hdr__inner">
    <a href="/" class="hdr__brand" aria-label="Dimensione Dolce"><img src="/assets/img/logo-dimensione-dolce-dark.png" alt="Dimensione Dolce"></a>
    <nav class="hdr__tabs">
      {sections.map((s, i) => (
        <a href={`#sec-${i}`} class:list={["hdr__tab", i === 0 && 'is-active']}>{s.title}</a>
      ))}
    </nav>
    <button class="hdr__cart" id="cartBtn">Ordine <span class="hdr__cart-count" id="count">0</span></button>
  </div>
</header>

<section class="hero">
  <div class="hero__kicker">La carta</div>
  <h1 class="hero__title">Il nostro <em>menu</em></h1>
  <p class="hero__lede">Scegli le tue preferite, personalizza con le varianti, porta a casa il gusto di Dimensione Dolce.</p>
</section>

{sections.map((sec, si) => (
  <section class:list={["sec", si % 2 === 0 && "sec--white"]} id={`sec-${si}`}>
    <header class="sec__head">
      <span class="sec__num">{['I.','II.','III.','IV.','V.','VI.'][si] || `${si+1}.`}</span>
      <h2 class="sec__title">{sec.title}</h2>
      <span class="sec__count">{String(sec.items.length).padStart(2,'0')} {sec.items.length === 1 ? 'Prodotto' : 'Prodotti'}</span>
    </header>
    <div class="carousel"><div class="carousel__track" data-section-index={si}>
      {sec.items.map((item, ii) => (
        sec.layout === 'gelato' ? (
          <article class="gelato" style={{ background: item.gelatoColor || 'var(--pistacchio)', color: lightTextOnGelato(item.gelatoColor) ? 'var(--bianco)' : 'var(--cioccolato-deep)' }}>
            {item.gelatoKicker && <p class="gelato__kicker">{item.gelatoKicker}</p>}
            <h3 class="gelato__name">{item.name}</h3>
            <p class="gelato__desc">{item.description}</p>
          </article>
        ) : (
          <article class="prod" data-item={JSON.stringify({ name: item.name, variants: item.variants })}>
            <div class="prod__img">
              {item.badge && <span class="prod__badge">{item.badge}</span>}
              {item.image && <img src={item.image} alt={item.name} loading="lazy" />}
              <button class="prod__add" aria-label={`Aggiungi ${item.name}`}>+</button>
            </div>
            <div class="prod__body">
              <h3 class="prod__name">{item.name}</h3>
              <p class="prod__desc">{item.description}</p>
              {item.variants.length > 1 && (
                <div class="prod__variants">
                  {item.variants.map((v, vi) => (
                    <button class:list={["prod__variant", vi === 0 && 'is-active']} data-price={v.price}>{v.name}</button>
                  ))}
                </div>
              )}
              <div class="prod__footer">
                <span class="prod__price">
                  {item.variants.length > 1 ? (<>
                    <span class="prod__price-from">da</span>
                    {`€${Number.isInteger(Math.min(...item.variants.map(v=>v.price))) ? Math.min(...item.variants.map(v=>v.price)) : Math.min(...item.variants.map(v=>v.price)).toFixed(2).replace(/\.00$/,'')}`}
                  </>) : (
                    `€${Number.isInteger(item.variants[0].price) ? item.variants[0].price : item.variants[0].price.toFixed(2).replace(/\.00$/,'')}`
                  )}
                </span>
              </div>
            </div>
          </article>
        )
      ))}
    </div></div>
  </section>
))}

<div class="toast" id="toast"><span class="toast__dot"></span><span id="toastMsg">Aggiunto</span></div>

<div class="order-backdrop" id="orderBackdrop"></div>
<aside class="order" id="orderPanel" aria-modal="true" role="dialog" aria-labelledby="orderTitle">
  <header class="order__head">
    <p class="order__kicker">Ritira in pasticceria</p>
    <h2 class="order__title" id="orderTitle">Il tuo ordine</h2>
    <button class="order__close" id="orderClose" aria-label="Chiudi">×</button>
  </header>
  <div class="order__scroll" id="orderBody"></div>
  <footer class="order__footer" id="orderFooter" style="display:none">
    <button class="order__submit" id="orderSubmit" disabled>Conferma ordine</button>
    <p class="order__submit-note">Pagamento al ritiro · Nessuna carta richiesta</p>
  </footer>
</aside>

<script is:inline>
  (function () {
    const countEl = document.getElementById('count');
    const toast = document.getElementById('toast');
    const toastMsg = document.getElementById('toastMsg');
    const orderPanel = document.getElementById('orderPanel');
    const orderBackdrop = document.getElementById('orderBackdrop');
    const orderBody = document.getElementById('orderBody');
    const orderFooter = document.getElementById('orderFooter');
    const orderSubmit = document.getElementById('orderSubmit');
    const orderClose = document.getElementById('orderClose');
    const cartBtn = document.getElementById('cartBtn');

    function el(t, c){ const e = document.createElement(t); if (c) e.className = c; return e; }
    function fmtPrice(p){ return '€' + (Number.isInteger(p) ? p : p.toFixed(2).replace(/\.00$/, '')); }

    // Duplicate carousel items for seamless loop
    document.querySelectorAll('.carousel__track').forEach(track => {
      const originals = Array.from(track.children);
      originals.forEach(child => {
        const clone = child.cloneNode(true);
        clone.setAttribute('aria-hidden', 'true');
        track.appendChild(clone);
      });
    });

    // Variants behavior
    document.querySelectorAll('.prod').forEach(prod => {
      const variants = prod.querySelectorAll('.prod__variant');
      const priceEl = prod.querySelector('.prod__price');
      variants.forEach(btn => {
        btn.addEventListener('click', () => {
          variants.forEach(b => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          priceEl.style.opacity = '0';
          setTimeout(() => {
            while (priceEl.firstChild) priceEl.removeChild(priceEl.firstChild);
            priceEl.textContent = fmtPrice(+btn.dataset.price);
            priceEl.style.opacity = '1';
          }, 180);
        });
      });
    });

    // Cart state
    const cart = [];
    let viewState = 'cart';
    let lastOrderRef = '';
    function cartItemId(n, v){ return n + '::' + v; }
    function cartTotal(){ return cart.reduce((s,i) => s + i.price * i.qty, 0); }
    function cartCount(){ return cart.reduce((s,i) => s + i.qty, 0); }

    function addItem({ name, variant, price }) {
      const id = cartItemId(name, variant);
      const existing = cart.find(i => i.id === id);
      if (existing) existing.qty++;
      else cart.push({ id, name, variant, price, qty: 1 });
      countEl.textContent = cartCount();
      toastMsg.textContent = name + ' · ' + variant;
      toast.classList.add('is-visible');
      clearTimeout(window.__tt);
      window.__tt = setTimeout(() => toast.classList.remove('is-visible'), 2000);
      viewState = 'cart';
      renderOrderPanel();
    }
    function updateQty(id, delta) {
      const idx = cart.findIndex(i => i.id === id);
      if (idx < 0) return;
      cart[idx].qty += delta;
      if (cart[idx].qty <= 0) cart.splice(idx, 1);
      countEl.textContent = cartCount();
      renderOrderPanel();
    }
    function removeItem(id) {
      const idx = cart.findIndex(i => i.id === id);
      if (idx >= 0) cart.splice(idx, 1);
      countEl.textContent = cartCount();
      renderOrderPanel();
    }

    // Add buttons
    document.querySelectorAll('.prod').forEach(prod => {
      const data = JSON.parse(prod.dataset.item);
      const add = prod.querySelector('.prod__add');
      add.addEventListener('click', (e) => {
        e.stopPropagation();
        const activeBtn = prod.querySelector('.prod__variant.is-active');
        const vName = activeBtn ? activeBtn.textContent.trim() : data.variants[0].name;
        const vPrice = activeBtn ? +activeBtn.dataset.price : data.variants[0].price;
        addItem({ name: data.name, variant: vName, price: vPrice });
      });
    });
    // Clones - need binding too: re-query after duplicate
    // Actually clones don't have listeners (cloneNode(true) doesn't clone listeners)
    // So we need to bind listeners on original nodes BEFORE cloning, OR use event delegation
    // We'll use event delegation for clones
    document.addEventListener('click', (e) => {
      const add = e.target.closest('.prod__add');
      if (!add) return;
      const prod = add.closest('.prod');
      if (!prod || prod.__bound) return; // avoid double fire on originals (which have listener)
      const data = JSON.parse(prod.dataset.item);
      const activeBtn = prod.querySelector('.prod__variant.is-active');
      const vName = activeBtn ? activeBtn.textContent.trim() : data.variants[0].name;
      const vPrice = activeBtn ? +activeBtn.dataset.price : data.variants[0].price;
      addItem({ name: data.name, variant: vName, price: vPrice });
    });
    // Mark originals as bound
    document.querySelectorAll('.carousel__track').forEach(track => {
      const originalCount = track.children.length / 2;
      for (let i = 0; i < originalCount; i++) {
        const ch = track.children[i];
        if (ch) ch.__bound = true;
      }
    });
    // Bind variant clicks on clones via delegation
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('.prod__variant');
      if (!btn) return;
      const prod = btn.closest('.prod');
      if (!prod || prod.__bound) return;
      const variants = prod.querySelectorAll('.prod__variant');
      variants.forEach(b => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      const priceEl = prod.querySelector('.prod__price');
      priceEl.style.opacity = '0';
      setTimeout(() => {
        while (priceEl.firstChild) priceEl.removeChild(priceEl.firstChild);
        priceEl.textContent = fmtPrice(+btn.dataset.price);
        priceEl.style.opacity = '1';
      }, 180);
    });

    function clearNode(n){ while (n.firstChild) n.removeChild(n.firstChild); }

    function buildField(name, labelText, placeholder, type, required) {
      const field = el('div', 'order__field');
      const label = el('label', 'order__label');
      label.setAttribute('for', 'f-' + name);
      label.appendChild(document.createTextNode(labelText));
      if (required) { const req = el('span', 'req'); req.textContent = '*'; label.appendChild(req); }
      const input = el('input', 'order__input');
      input.type = type; input.id = 'f-' + name; input.name = name;
      input.placeholder = placeholder;
      if (required) input.setAttribute('required', '');
      field.appendChild(label); field.appendChild(input);
      return field;
    }

    function buildConsent(name, required, textMain, noteText, link) {
      const label = el('label', 'order__consent');
      const input = el('input');
      input.type = 'checkbox'; input.name = name;
      if (required) input.setAttribute('required', '');
      const box = el('span', 'order__consent-box');
      const text = el('span', 'order__consent-text');
      text.appendChild(document.createTextNode(textMain + ' '));
      if (link) {
        const a = el('a');
        a.href = link.href; a.textContent = link.text; a.target = '_blank';
        text.appendChild(a);
        text.appendChild(document.createTextNode('.'));
      }
      if (noteText) {
        const note = el('span');
        note.style.display = 'block'; note.style.marginTop = '4px';
        note.style.fontSize = '11px'; note.style.color = 'var(--testo-muted)';
        note.textContent = noteText;
        text.appendChild(note);
      }
      label.appendChild(input); label.appendChild(box); label.appendChild(text);
      return label;
    }

    function wireFormValidation() {
      const form = document.getElementById('orderForm');
      if (!form) return;
      const inputs = [form.querySelector('[name="nome"]'), form.querySelector('[name="cognome"]'), form.querySelector('[name="telefono"]')];
      const privacy = orderBody.querySelector('input[name="privacy"]');
      function check() {
        const ok = inputs.every(i => i && i.value.trim().length > 1) && privacy && privacy.checked;
        orderSubmit.disabled = !ok;
      }
      inputs.forEach(i => { if (i) i.addEventListener('input', check); });
      if (privacy) privacy.addEventListener('change', check);
      check();
    }

    function renderSuccess() {
      const s = el('div', 'order__success');
      const seal = el('div', 'order__success-seal'); seal.textContent = 'a';
      const title = el('h3', 'order__success-title'); title.textContent = 'Ordine ricevuto';
      const text = el('p', 'order__success-text'); text.textContent = "Grazie della fiducia. Ti scriviamo entro un paio d'ore per confermare il giorno e l'orario del ritiro.";
      const ref = el('div', 'order__success-ref');
      ref.appendChild(document.createTextNode('Riferimento'));
      const refStrong = el('strong'); refStrong.textContent = '#' + lastOrderRef;
      ref.appendChild(refStrong);
      const action = el('div', 'order__success-action');
      const btn = el('button'); btn.type = 'button'; btn.textContent = 'Nuovo ordine';
      btn.addEventListener('click', () => {
        cart.length = 0; countEl.textContent = 0;
        viewState = 'cart'; renderOrderPanel();
      });
      action.appendChild(btn);
      s.appendChild(seal); s.appendChild(title); s.appendChild(text); s.appendChild(ref); s.appendChild(action);
      orderBody.appendChild(s);
    }

    function renderOrderPanel() {
      clearNode(orderBody);
      if (viewState === 'success') { renderSuccess(); orderFooter.style.display = 'none'; return; }
      if (cart.length === 0) {
        const empty = el('div', 'order__empty');
        const mark = el('div', 'order__empty-mark'); mark.textContent = '—';
        const title = el('h3', 'order__empty-title'); title.textContent = 'Ancora vuoto';
        const text = el('p', 'order__empty-text'); text.textContent = 'Aggiungi i prodotti dalla carta per iniziare a comporre la tua selezione.';
        empty.appendChild(mark); empty.appendChild(title); empty.appendChild(text);
        orderBody.appendChild(empty);
        orderFooter.style.display = 'none';
        return;
      }
      const list = el('div', 'order__list');
      const label = el('div', 'order__list-label');
      const lL = el('span'); lL.textContent = 'La selezione';
      const lR = el('span'); lR.textContent = cartCount() + ' ' + (cartCount() === 1 ? 'pezzo' : 'pezzi');
      label.appendChild(lL); label.appendChild(lR);
      list.appendChild(label);
      cart.forEach(item => {
        const row = el('div', 'order__item');
        const name = el('div', 'order__item-name'); name.textContent = item.name;
        const price = el('div', 'order__item-price'); price.textContent = fmtPrice(item.price * item.qty);
        row.appendChild(name); row.appendChild(price);
        const variant = el('div', 'order__item-variant'); variant.textContent = item.variant;
        row.appendChild(variant);
        const controls = el('div', 'order__item-controls');
        const qty = el('div', 'order__qty');
        const minus = el('button'); minus.textContent = '−'; minus.setAttribute('aria-label', 'Rimuovi uno');
        const qv = el('span', 'order__qty-val'); qv.textContent = item.qty;
        const plus = el('button'); plus.textContent = '+'; plus.setAttribute('aria-label', 'Aggiungi uno');
        minus.addEventListener('click', () => updateQty(item.id, -1));
        plus.addEventListener('click', () => updateQty(item.id, 1));
        qty.appendChild(minus); qty.appendChild(qv); qty.appendChild(plus);
        const remove = el('button', 'order__item-remove'); remove.textContent = 'Rimuovi';
        remove.addEventListener('click', () => removeItem(item.id));
        controls.appendChild(qty); controls.appendChild(remove);
        row.appendChild(controls);
        list.appendChild(row);
      });
      orderBody.appendChild(list);
      const totals = el('div', 'order__totals');
      const sub = el('div', 'order__total-row');
      const sL = el('span'); sL.textContent = 'Subtotale';
      const sV = el('span', 'order__total-value'); sV.textContent = fmtPrice(cartTotal());
      sub.appendChild(sL); sub.appendChild(sV);
      const tot = el('div', 'order__total-row is-total');
      const tL = el('span', 'order__total-label'); tL.textContent = 'Totale';
      const tV = el('span', 'order__total-value'); tV.textContent = fmtPrice(cartTotal());
      tot.appendChild(tL); tot.appendChild(tV);
      totals.appendChild(sub); totals.appendChild(tot);
      orderBody.appendChild(totals);

      const form = el('form', 'order__form');
      form.id = 'orderForm'; form.setAttribute('novalidate', '');
      const fh = el('div', 'order__form-head');
      const fn = el('span', 'order__form-num'); fn.textContent = 'II.';
      const ft = el('h3', 'order__form-title'); ft.textContent = 'I tuoi contatti';
      fh.appendChild(fn); fh.appendChild(ft);
      form.appendChild(fh);
      const fs = el('p', 'order__form-sub'); fs.textContent = 'Ti scriveremo per confermare giorno e orario del ritiro.';
      form.appendChild(fs);
      const row1 = el('div', 'order__row');
      row1.appendChild(buildField('nome', 'Nome', 'Elena', 'text', true));
      row1.appendChild(buildField('cognome', 'Cognome', 'Conti', 'text', true));
      form.appendChild(row1);
      form.appendChild(buildField('telefono', 'Telefono', '+39 345 123 4567', 'tel', true));
      orderBody.appendChild(form);

      const consents = el('div', 'order__consents');
      consents.appendChild(buildConsent('privacy', true,
        'Ho letto e accetto la',
        'Obbligatorio per proseguire con la prenotazione.',
        { href: '/privacy', text: 'Privacy Policy' }));
      consents.appendChild(buildConsent('marketing', false,
        'Voglio ricevere le novità e le stagionali di Dimensione Dolce.',
        'Niente spam, promesso. Una email al mese al massimo.'));
      orderBody.appendChild(consents);

      orderFooter.style.display = 'block';
      wireFormValidation();
    }

    function openOrder() {
      orderPanel.classList.add('is-open');
      orderBackdrop.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      renderOrderPanel();
    }
    function closeOrder() {
      orderPanel.classList.remove('is-open');
      orderBackdrop.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    cartBtn.addEventListener('click', openOrder);
    orderClose.addEventListener('click', closeOrder);
    orderBackdrop.addEventListener('click', closeOrder);
    document.addEventListener('keydown', e => { if (e.key === 'Escape' && orderPanel.classList.contains('is-open')) closeOrder(); });

    orderSubmit.addEventListener('click', () => {
      const form = document.getElementById('orderForm');
      if (!form) return;
      lastOrderRef = Math.random().toString(36).slice(2, 8).toUpperCase();
      viewState = 'success';
      cart.length = 0;
      countEl.textContent = 0;
      renderOrderPanel();
    });

    renderOrderPanel();

    // Scrollspy
    const observer = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          document.querySelectorAll('.hdr__tab').forEach(t => t.classList.remove('is-active'));
          const tab = document.querySelector('.hdr__tab[href="#' + e.target.id + '"]');
          if (tab) tab.classList.add('is-active');
        }
      });
    }, { rootMargin: '-30% 0px -60% 0px' });
    document.querySelectorAll('.sec').forEach(s => observer.observe(s));
  })();
</script>
</body>
</html>
