---
export const prerender = true;
import ShopLayout from '../layouts/ShopLayout.astro';
---
<ShopLayout
  title="I Nostri Prodotti | Dimensione Dolce"
  description="Scopri i prodotti artigianali Dimensione Dolce. Panettone al Pistacchio, Panettone al Cioccolato e Crema Spalmabile. Spedizione in tutta Italia."
>

  <!-- ========== SHOP HERO ========== -->
  <section class="shop-hero">
    <span class="shop-hero__keyword" aria-hidden="true">DOLCEZZE</span>
    <h1 class="shop-hero__title fade-in-up">I Nostri Prodotti</h1>
    <div class="shop-hero__line fade-in-up delay-1"></div>
    <p class="shop-hero__subtitle fade-in-up delay-2">Artigianali dal 1962 &mdash; Spedizione gratuita sopra 80&euro;</p>
  </section>

  <!-- ========== PRODUCT GRID ========== -->
  <section class="shop-grid">
    <div class="shop-grid__inner">

      <!-- Card 1: Pistacchio -->
      <div class="shop-card shop-card--pistacchio fade-in-up delay-1">
        <div class="shop-card__accent"></div>
        <div class="shop-card__image">
          <img src="/assets/img/box-pistacchio.png" alt="Panettone al Pistacchio di Bronte">
        </div>
        <div class="shop-card__body">
          <h2 class="shop-card__name">Il Pistacchio</h2>
          <p class="shop-card__desc">Crema di pistacchio puro di Bronte al 65%, gocce di cioccolato bianco e glassa croccante. Edizione limitata.</p>
          <div class="shop-card__bottom">
            <span class="shop-card__price">&euro;45,00</span>
            <a href="/product-pistacchio" class="shop-card__cta">Scopri</a>
          </div>
        </div>
        <div class="custom-cursor-card"><span>SCOPRI</span></div>
      </div>

      <!-- Card 2: Cioccolato -->
      <div class="shop-card shop-card--cioccolato fade-in-up delay-2">
        <div class="shop-card__accent"></div>
        <div class="shop-card__image">
          <img src="/assets/img/box-cioccolato.png" alt="Panettone Triplo Cioccolato">
        </div>
        <div class="shop-card__body">
          <h2 class="shop-card__name">Il Cioccolato</h2>
          <p class="shop-card__desc">Tre origini di cacao monorigine: Madagascar, Ecuador e Venezuela. Fondente 72%, al latte e gianduia piemontese.</p>
          <div class="shop-card__bottom">
            <span class="shop-card__price">&euro;42,00</span>
            <a href="/product-cioccolato" class="shop-card__cta">Scopri</a>
          </div>
        </div>
        <div class="custom-cursor-card"><span>SCOPRI</span></div>
      </div>

      <!-- Card 3: Crema Spalmabile -->
      <div class="shop-card shop-card--crema fade-in-up delay-3">
        <div class="shop-card__accent"></div>
        <div class="shop-card__image">
          <img src="/assets/img/box-crema.png" alt="Crema Spalmabile al Cioccolato">
        </div>
        <div class="shop-card__body">
          <h2 class="shop-card__name">La Crema</h2>
          <p class="shop-card__desc">Cioccolato fondente monorigine e nocciole Piemonte IGP. Senza olio di palma, senza conservanti. Puro piacere.</p>
          <div class="shop-card__bottom">
            <span class="shop-card__price">&euro;18,00</span>
            <a href="/product-crema" class="shop-card__cta">Scopri</a>
          </div>
        </div>
        <div class="custom-cursor-card"><span>SCOPRI</span></div>
      </div>

    </div>
  </section>

  <!-- Shop-specific: Custom cursor on cards -->
  <script slot="scripts" is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      if (window.innerWidth < 1024) return;

      document.querySelectorAll('.shop-card').forEach((card) => {
        const cursor = card.querySelector('.custom-cursor-card');
        if (!cursor) return;

        let mouseX = 0, mouseY = 0, curX = 0, curY = 0;
        let isInCard = false;
        let rafId = null;

        card.addEventListener('mouseenter', () => {
          isInCard = true;
          cursor.style.opacity = '1';
          if (!rafId) animateCursor();
        });

        card.addEventListener('mouseleave', () => {
          isInCard = false;
          cursor.style.opacity = '0';
        });

        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          mouseX = e.clientX - rect.left;
          mouseY = e.clientY - rect.top;
        });

        // Hide custom cursor over interactive elements
        card.querySelectorAll('a, button').forEach((el) => {
          el.addEventListener('mouseenter', () => { cursor.style.opacity = '0'; card.style.cursor = 'pointer'; });
          el.addEventListener('mouseleave', () => { if (isInCard) { cursor.style.opacity = '1'; card.style.cursor = 'none'; } });
        });

        function animateCursor() {
          curX += (mouseX - curX) * 0.12;
          curY += (mouseY - curY) * 0.12;
          cursor.style.transform = `translate(${curX}px, ${curY}px) translate(-50%, -50%)`;
          if (isInCard) {
            rafId = requestAnimationFrame(animateCursor);
          } else {
            rafId = null;
          }
        }
      });
    });
  </script>

</ShopLayout>
